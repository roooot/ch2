# ==========================================
# Liara Copilot - نمونه فایل Environment Variables
# این فایل را کپی کرده و به نام .env.local ذخیره کنید
# ==========================================

# --- دیتابیس MySQL (لیارا DBaaS یا لوکال) ---
# فرمت: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# --- کلید API مدل زبانی (سازگار با OpenAI) ---
# می‌تواند OpenAI واقعی یا هر سرویس سازگار (مثل AvalAI، LiteLLM proxy و ...) باشد
OPENAI_API_KEY="replace-with-a-real-api-key"
# در صورت استفاده از Base URL سازگار (اختیاری)
OPENAI_BASE_URL="https://api.avalai.ir/v1"

# --- تنظیمات مدل دو سطحی ---
# مدل ارزان برای Intent Classification و Rerank
MODEL_CHEAP="gpt-4o-mini"
# مدل قوی‌تر برای پاسخ نهایی RAG
MODEL_STRONG="gpt-4o"
# مدل Embedding
MODEL_EMBEDDING="text-embedding-3-small"

# --- امنیت ---
# کلید مخفی برای عملیات ادمین (ingestion، پاکسازی کش)
ADMIN_SECRET="generate-a-long-random-secret-before-deploying"

# --- Rate Limiting ---
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000

# --- Redis اختیاری برای Rate Limiting توزیع‌شده (در صورت نبود، حافظه داخلی استفاده می‌شود) ---
REDIS_URL=""

# --- محیط اجرا ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="https://YOUR-APP.liara.run"

# --- منبع ingestion مستندات لیارا ---
DOCS_GITHUB_REPO="liara-cloud/docs"
DOCS_GITHUB_BRANCH="master"
